# Dependencies
node_modules/

# Environment and Secrets (CRITICAL: Never commit private credentials)
.env
.env.local
.env.*.local
*.env

# SQLite runtime files, databases & locks (Avoid leaking user records)
database/*.db
database/*.db-shm
database/*.db-wal

# Large binaries and executables (Keep repository lightweight and private)
scripts/*.exe
scripts/ngrok.exe
*.exe

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
