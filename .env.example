# ========================================================
# Foodie Express - Example Environment Configuration
# Copy this file to '.env' and fill in your actual values.
# ========================================================

# Server Port
PORT=3000

# Environment Mode (development | production)
NODE_ENV=development

# Cryptographic Token Secret (Use any random 32+ char hex/string)
JWT_SECRET=replace_with_a_secure_random_secret_string

# Password Salt for Credential Hashing
PASSWORD_SALT=replace_with_a_secure_salt

# Direct Admin Server-to-Server API Key (Optional)
ADMIN_API_KEY=replace_with_admin_api_key

# Ngrok Static Domain / Mobile Tunnel URL (Optional)
# If left blank, standard ngrok dynamic tunnel is used
NGROK_DOMAIN=
TUNNEL_URL=
